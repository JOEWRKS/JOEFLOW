{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joewrks.action-conformance/2.0",
  "type": "object",
  "required": ["contract_schema_version", "compiler", "source_authority", "responsibility_profile", "scope_commitments", "source_seed_inventory", "actions", "lifecycles", "semantic_debt", "handoff_status", "semantic_assurance", "semantic_contract_hash", "artifact_hash"],
  "additionalProperties": false,
  "properties": {
    "contract_schema_version": {"const": "joewrks.action-conformance/2.0"},
    "compiler": {"type": "object", "required": ["id", "version"], "additionalProperties": false, "properties": {"id": {"const": "joewrks-product-definition/downstream-v2"}, "version": {"const": "core-semantic-closure-v2-m5.1"}}},
    "source_authority": {"$ref": "#/$defs/sourceAuthority"},
    "responsibility_profile": {"type": "object", "required": ["profile_id", "digest"], "additionalProperties": false, "properties": {"profile_id": {"const": "joewrks.downstream-responsibility/1.0"}, "digest": {"$ref": "#/$defs/hash"}}},
    "scope_commitments": {"type": "array", "items": {"$ref": "#/$defs/scopeCommitment"}},
    "source_seed_inventory": {"type": "array", "items": {"$ref": "#/$defs/sourceSeed"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "lifecycles": {"type": "array", "items": {"$ref": "#/$defs/lifecycle"}},
    "semantic_debt": {"$ref": "#/$defs/semanticDebt"},
    "handoff_status": {"enum": ["AUTHORITY_READY_MACHINE_VERIFIED", "AUTHORITY_READY_REVIEW_PENDING"]},
    "semantic_assurance": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"enum": ["NOT_REQUIRED", "NOT_MEASURED"]}}},
    "semantic_contract_hash": {"$ref": "#/$defs/hash"},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scopeRef": {"type": "string", "pattern": "^(REQ|SURF|SCR)-[^\\s]+$"},
    "scopeRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scopeRef"}},
    "productBindingIdentity": {"type": "object", "required": ["contract_id", "version", "digest"], "additionalProperties": false, "properties": {"contract_id": {"const": "joewrks.product-coverage-binding"}, "version": {"const": "1.0"}, "digest": {"const": "b57459533247de52038aacb158e785c2184edcdd2fa6831f0edc3db713775f3c"}}},
    "uxBindingIdentity": {"type": "object", "required": ["contract_id", "version", "digest"], "additionalProperties": false, "properties": {"contract_id": {"const": "joewrks.ux-coverage-binding"}, "version": {"const": "1.0"}, "digest": {"const": "8fc84057a4a6f0f0ce329a58d11b8e208989800147d703665cea52088de0be0d"}}},
    "sourceAuthority": {
      "type": "object",
      "required": ["state_schema_version", "product_slug", "approved_revision", "approved_definition_digest", "approved_manifest_digest", "product_binding_contract", "ux_binding_contract", "snapshot_state_sha256", "consumed_seed_inventory_digest"],
      "additionalProperties": false,
      "properties": {
        "state_schema_version": {"const": "0.2.0"},
        "product_slug": {"type": "string", "pattern": ".*\\S.*"},
        "approved_revision": {"type": "integer", "minimum": 1},
        "approved_definition_digest": {"$ref": "#/$defs/hash"},
        "approved_manifest_digest": {"$ref": "#/$defs/hash"},
        "product_binding_contract": {"$ref": "#/$defs/productBindingIdentity"},
        "ux_binding_contract": {"$ref": "#/$defs/uxBindingIdentity"},
        "snapshot_state_sha256": {"$ref": "#/$defs/hash"},
        "consumed_seed_inventory_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "scopeCommitment": {"type": "object", "required": ["record_id", "record_type", "record_sha256"], "additionalProperties": false, "properties": {"record_id": {"$ref": "#/$defs/scopeRef"}, "record_type": {"enum": ["REQ", "SURF", "SCR"]}, "record_sha256": {"$ref": "#/$defs/hash"}}},
    "location": {"type": "object", "required": ["scope", "owner_ref", "axis", "pack_id", "action_key"], "additionalProperties": false, "properties": {"scope": {"enum": ["CORE", "GRILL", "UX_STATE", "UX_ACTION"]}, "owner_ref": {"$ref": "#/$defs/scopeRef"}, "axis": {"type": "string", "pattern": ".*\\S.*"}, "pack_id": {"oneOf": [{"type": "string", "pattern": ".*\\S.*"}, {"type": "null"}]}, "action_key": {"oneOf": [{"type": "string", "pattern": ".*\\S.*"}, {"type": "null"}]}}},
    "sourceSeed": {"type": "object", "required": ["seed_key", "location", "record_id", "record_type", "pointer", "value_sha256", "source_status", "value"], "additionalProperties": false, "properties": {"seed_key": {"type": "string", "pattern": "^SEED-[0-9a-f]+$"}, "location": {"$ref": "#/$defs/location"}, "record_id": {"type": "string", "pattern": ".*\\S.*"}, "record_type": {"type": "string", "pattern": ".*\\S.*"}, "pointer": {"type": "string", "pattern": "^/"}, "value_sha256": {"$ref": "#/$defs/hash"}, "source_status": {"const": "CURRENT"}, "value": {}}},
    "directDerivation": {"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"const": "DIRECT_AUTHORITY"}}},
    "extractDerivation": {"type": "object", "required": ["kind", "operator", "pointer"], "additionalProperties": false, "properties": {"kind": {"const": "MACHINE_DERIVED"}, "operator": {"const": "extract"}, "pointer": {"type": "string", "pattern": "^/"}}},
    "selectDerivation": {"type": "object", "required": ["kind", "operator", "keys"], "additionalProperties": false, "properties": {"kind": {"const": "MACHINE_DERIVED"}, "operator": {"const": "select"}, "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": ".*\\S.*"}}}},
    "reviewDerivation": {"type": "object", "required": ["kind", "why_structuring_is_insufficient", "interpretation_scope"], "additionalProperties": false, "properties": {"kind": {"const": "REVIEW_REQUIRED"}, "why_structuring_is_insufficient": {"type": "string", "pattern": ".*\\S.*"}, "interpretation_scope": {"type": "string", "pattern": ".*\\S.*"}}},
    "semanticField": {"type": "object", "required": ["value", "source_seed_refs", "derivation"], "additionalProperties": false, "properties": {"value": {}, "source_seed_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SEED-[0-9a-f]+$"}}, "derivation": {"oneOf": [{"$ref": "#/$defs/directDerivation"}, {"$ref": "#/$defs/extractDerivation"}, {"$ref": "#/$defs/selectDerivation"}, {"$ref": "#/$defs/reviewDerivation"}]}}},
    "locator": {"type": "object", "required": ["screen_ref", "action_key"], "additionalProperties": false, "properties": {"screen_ref": {"type": "string", "pattern": "^SCR-[^\\s]+$"}, "action_key": {"type": "string", "pattern": ".*\\S.*"}}},
    "actionFields": {
      "type": "object", "additionalProperties": false,
      "required": ["actor", "authentication", "relationship_predicate", "object_binding", "concurrency", "preconditions", "allowed_current_states", "forbidden_states", "input_invariants", "command", "expected_domain_mutation", "forbidden_mutations", "default_result", "result_expectations", "version_result", "history_result", "business_side_effects", "delivery_effects", "idempotency", "rejection", "recovery", "visible_success", "visible_error", "superseded_rules", "test_obligations", "trace"],
      "properties": {
        "actor": {"$ref": "#/$defs/semanticField"}, "authentication": {"$ref": "#/$defs/semanticField"}, "relationship_predicate": {"$ref": "#/$defs/semanticField"}, "object_binding": {"$ref": "#/$defs/semanticField"}, "concurrency": {"$ref": "#/$defs/semanticField"}, "preconditions": {"$ref": "#/$defs/semanticField"}, "allowed_current_states": {"$ref": "#/$defs/semanticField"}, "forbidden_states": {"$ref": "#/$defs/semanticField"}, "input_invariants": {"$ref": "#/$defs/semanticField"}, "command": {"$ref": "#/$defs/semanticField"}, "expected_domain_mutation": {"$ref": "#/$defs/semanticField"}, "forbidden_mutations": {"$ref": "#/$defs/semanticField"}, "default_result": {"$ref": "#/$defs/semanticField"}, "result_expectations": {"$ref": "#/$defs/semanticField"}, "version_result": {"$ref": "#/$defs/semanticField"}, "history_result": {"$ref": "#/$defs/semanticField"}, "business_side_effects": {"$ref": "#/$defs/semanticField"}, "delivery_effects": {"$ref": "#/$defs/semanticField"}, "idempotency": {"$ref": "#/$defs/semanticField"}, "rejection": {"$ref": "#/$defs/semanticField"}, "recovery": {"$ref": "#/$defs/semanticField"}, "visible_success": {"$ref": "#/$defs/semanticField"}, "visible_error": {"$ref": "#/$defs/semanticField"}, "superseded_rules": {"$ref": "#/$defs/semanticField"}, "test_obligations": {"$ref": "#/$defs/semanticField"}, "trace": {"$ref": "#/$defs/semanticField"}
      }
    },
    "lifecycleFields": {
      "type": "object", "additionalProperties": false,
      "required": ["current_states", "allowed_transitions", "forbidden_transitions", "boundary_conditions", "reversibility", "reversal_window", "object_outcome", "required_reason", "required_confirmation", "required_evidence", "authority", "history_preservation"],
      "properties": {"current_states": {"$ref": "#/$defs/semanticField"}, "allowed_transitions": {"$ref": "#/$defs/semanticField"}, "forbidden_transitions": {"$ref": "#/$defs/semanticField"}, "boundary_conditions": {"$ref": "#/$defs/semanticField"}, "reversibility": {"$ref": "#/$defs/semanticField"}, "reversal_window": {"$ref": "#/$defs/semanticField"}, "object_outcome": {"$ref": "#/$defs/semanticField"}, "required_reason": {"$ref": "#/$defs/semanticField"}, "required_confirmation": {"$ref": "#/$defs/semanticField"}, "required_evidence": {"$ref": "#/$defs/semanticField"}, "authority": {"$ref": "#/$defs/semanticField"}, "history_preservation": {"$ref": "#/$defs/semanticField"}}
    },
    "action": {"type": "object", "required": ["action_id", "authority_scope_refs", "ux_action_locator", "fields"], "additionalProperties": false, "properties": {"action_id": {"type": "string", "pattern": ".*\\S.*"}, "authority_scope_refs": {"$ref": "#/$defs/scopeRefs"}, "ux_action_locator": {"oneOf": [{"$ref": "#/$defs/locator"}, {"type": "null"}]}, "fields": {"$ref": "#/$defs/actionFields"}}},
    "lifecycle": {"type": "object", "required": ["lifecycle_id", "authority_scope_refs", "fields"], "additionalProperties": false, "properties": {"lifecycle_id": {"type": "string", "pattern": ".*\\S.*"}, "authority_scope_refs": {"$ref": "#/$defs/scopeRefs"}, "fields": {"$ref": "#/$defs/lifecycleFields"}}},
    "semanticDebt": {
      "type": "object", "required": ["direct_authority_count", "machine_derived_count", "review_required_count", "authority_gap_count", "direct_authority_fields", "machine_derived_fields", "review_required_fields", "authority_gaps"], "additionalProperties": false,
      "properties": {"direct_authority_count": {"type": "integer", "minimum": 0}, "machine_derived_count": {"type": "integer", "minimum": 0}, "review_required_count": {"type": "integer", "minimum": 0}, "authority_gap_count": {"const": 0}, "direct_authority_fields": {"type": "array", "items": {"type": "string"}}, "machine_derived_fields": {"type": "array", "items": {"type": "string"}}, "review_required_fields": {"type": "array", "items": {"type": "string"}}, "authority_gaps": {"const": []}}
    }
  }
}
