        "rules": {"type": "array", "items": {"$ref": "#/$defs/rules"}},
        "flows": {"type": "array", "items": {"$ref": "#/$defs/flows"}},
        "screens": {"type": "array", "items": {"$ref": "#/$defs/screens"}},
        "states": {"type": "array", "items": {"$ref": "#/$defs/states"}},
        "data": {"type": "array", "items": {"$ref": "#/$defs/data"}},
