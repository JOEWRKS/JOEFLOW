        "properties": {
          "approval": {"properties": {"status": {"const": "APPROVED"}}}
        }
      },
      "else": {
        "properties": {
          "approval": {"properties": {"status": {"const": "UNAPPROVED"}}}
        }
      }
    }
  ]
