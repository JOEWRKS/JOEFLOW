{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JOEWRKS Product Definition State 0.2.0 Foundation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "migration", "evidence", "surface_manifest", "contradictions", "objects", "coverage", "ux_coverage", "grill_coverage", "discovery_baseline", "approval", "approval_history"],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "binding_contract_identity": {"type": "object", "additionalProperties": false, "required": ["contract_id", "version", "digest"], "properties": {"contract_id": {"type": "string"}, "version": {"const": "1.0"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "migration_legacy_record": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_group", "source_record", "source_record_sha256"],
      "properties": {
        "source_id": {"oneOf": [{"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, {"type": "null"}]},
        "source_group": {"enum": ["goals", "users", "requirements", "unknowns", "decisions", "rules", "flows", "screens", "states", "data", "integrations", "acceptance_criteria", "tasks", "contradictions"]},
        "source_record": {"type": "object"},
        "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "migration_reconciliation_gap": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_path", "missing_v2_fields", "reason_code"],
      "properties": {
        "source_id": {"oneOf": [{"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, {"type": "null"}]},
        "source_path": {"type": "string", "pattern": "^/"},
        "missing_v2_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "reason_code": {"const": "MISSING_V2_SEMANTIC_AUTHORITY"}
      }
    },
    "migration_native": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"], "properties": {"mode": {"const": "NATIVE"}}
    },
    "migration_migrated": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "from_schema", "to_schema", "migration_version", "source_digest", "source_revision", "source_legacy_status", "source_legacy_approval_digest", "plan_digest", "preserved_ids", "promoted_ids", "generated_ids", "legacy_records", "reconciliation_gaps", "reconciliation_gap_count"],
      "properties": {
        "mode": {"const": "MIGRATED"},
        "from_schema": {"const": "0.1.2.1"},
        "to_schema": {"const": "0.2.0"},
        "migration_version": {"const": "0.2.0-m6.1"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_revision": {"type": "integer", "minimum": 1},
        "source_legacy_status": {"enum": ["OPEN", "READY_FOR_REVIEW", "CLOSED", "BLOCKED"]},
        "source_legacy_approval_digest": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preserved_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "uniqueItems": true},
        "promoted_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "uniqueItems": true},
        "generated_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "uniqueItems": true},
        "legacy_records": {"type": "array", "items": {"$ref": "#/$defs/migration_legacy_record"}},
        "reconciliation_gaps": {
          "type": "object",
          "propertyNames": {"pattern": "^gap:[0-9a-f]{24}$"},
          "additionalProperties": {"$ref": "#/$defs/migration_reconciliation_gap"}
        },
        "reconciliation_gap_count": {"type": "integer", "minimum": 0}
      }
    },
    "migration": {"oneOf": [{"$ref": "#/$defs/migration_native"}, {"$ref": "#/$defs/migration_migrated"}]},
    "string_array": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authority_binding": {"type": "object", "additionalProperties": false, "required": ["record_id", "pointer", "value_sha256"], "properties": {"record_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "pointer": {"type": "string"}, "value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "core_coverage_cell": {"type": "object", "additionalProperties": false, "required": ["status", "authority_bindings", "unknown_refs", "basis_bindings", "rationale"], "properties": {"status": {"enum": ["COVERED", "OPEN", "N/A"]}, "authority_bindings": {"type": "array", "items": {"$ref": "#/$defs/authority_binding"}}, "unknown_refs": {"type": "array", "items": {"type": "string", "pattern": "^UNK-[0-9]{3,}$"}, "uniqueItems": true}, "basis_bindings": {"type": "array", "items": {"$ref": "#/$defs/authority_binding"}}, "rationale": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}}},
    "core_coverage_row": {"type": "object", "additionalProperties": false, "required": ["feature_id", "cells"], "properties": {"feature_id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}, "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/core_coverage_cell"}}}},
    "ux_action_row": {"type": "object", "additionalProperties": false, "required": ["key", "cells"], "properties": {"key": {"type": "string", "minLength": 1}, "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/core_coverage_cell"}}}},
    "ux_coverage_row": {"type": "object", "additionalProperties": false, "required": ["screen_id", "states", "actions"], "properties": {"screen_id": {"type": "string", "pattern": "^SCR-[0-9]{3,}$"}, "states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/core_coverage_cell"}}, "actions": {"type": "array", "items": {"$ref": "#/$defs/ux_action_row"}}}},
    "normal_status": {"enum": ["CURRENT", "STALE", "SUPERSEDED", "RETIRED"]},
    "unknown_status": {"enum": ["OPEN", "RESOLVED", "DEFERRED", "BLOCKED", "SUPERSEDED", "RETIRED"]},
    "decision_authority": {"enum": ["EVIDENCE_RESOLVABLE", "AGENT_AUTONOMOUS", "USER_CONFIRMATION", "USER_DECISION_REQUIRED", "EXTERNAL_AUTHORITY_REQUIRED"]},
    "resolution_mode": {"enum": ["EVIDENCE", "USER_DECISION", "USER_ACCEPTED_RECOMMENDATION", "AGENT_NON_MATERIAL_DEFAULT", "EXTERNAL_CONSTRAINT", "MIGRATION_RECONCILIATION"]},
    "nullable_resolution_mode": {"oneOf": [{"$ref": "#/$defs/resolution_mode"}, {"type": "null"}]},
    "unknown_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "surface_ref", "pack_id", "axis_id", "source_path"],
      "properties": {
        "kind": {"enum": ["PRODUCT_SURFACE", "GRILL_TOPOLOGY", "GRILL_PACK_AXIS", "MIGRATION_RECONCILIATION", "MANUAL"]},
        "surface_ref": {"oneOf": [{"type": "string", "pattern": "^SURF-[0-9]{3,}$"}, {"type": "null"}]},
        "pack_id": {"oneOf": [{"enum": ["GRILL-AUTH-1", "GRILL-MONEY-1", "GRILL-FILE-UPLOAD-1", "GRILL-ASYNC-1", "GRILL-PERMISSION-1", "GRILL-DESTRUCTIVE-ACTION-1"]}, {"type": "null"}]},
        "axis_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "source_path": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "PRODUCT_SURFACE"}, "surface_ref": {"type": "string", "pattern": "^SURF-[0-9]{3,}$"}, "pack_id": {"type": "null"}, "axis_id": {"type": "null"}, "source_path": {"type": "null"}}},
        {"properties": {"kind": {"const": "GRILL_TOPOLOGY"}, "surface_ref": {"type": "null"}, "pack_id": {"enum": ["GRILL-AUTH-1", "GRILL-MONEY-1", "GRILL-FILE-UPLOAD-1", "GRILL-ASYNC-1", "GRILL-PERMISSION-1", "GRILL-DESTRUCTIVE-ACTION-1"]}, "axis_id": {"type": "null"}, "source_path": {"type": "null"}}},
        {
          "properties": {"kind": {"const": "GRILL_PACK_AXIS"}, "surface_ref": {"type": "string", "pattern": "^SURF-[0-9]{3,}$"}, "source_path": {"type": "null"}},
          "oneOf": [
            {"properties": {"pack_id": {"const": "GRILL-AUTH-1"}, "axis_id": {"enum": ["registration", "verification", "login", "logout", "session_expiry", "session_renewal", "password_reset", "account_recovery", "revocation", "role_change", "provider_failure", "duplicate_identity", "account_linking"]}}},
            {"properties": {"pack_id": {"const": "GRILL-MONEY-1"}, "axis_id": {"enum": ["currency", "price_authority", "tax", "discount", "payment_failure", "duplicate_payment", "refund", "partial_refund", "cancellation", "chargeback", "settlement", "receipt"]}}},
            {"properties": {"pack_id": {"const": "GRILL-FILE-UPLOAD-1"}, "axis_id": {"enum": ["type", "size", "quota", "malware", "processing", "partial_failure", "resume", "retention", "deletion", "ownership", "download_permission"]}}},
            {"properties": {"pack_id": {"const": "GRILL-ASYNC-1"}, "axis_id": {"enum": ["pending", "polling", "timeout", "retry", "idempotency", "duplicate_execution", "late_completion", "partial_completion", "cancel", "reconciliation"]}}},
            {"properties": {"pack_id": {"const": "GRILL-PERMISSION-1"}, "axis_id": {"enum": ["role", "resource_ownership", "read", "write", "delete", "delegation", "revocation", "role_change_mid_flow", "stale_permission", "audit"]}}},
            {"properties": {"pack_id": {"const": "GRILL-DESTRUCTIVE-ACTION-1"}, "axis_id": {"enum": ["confirmation", "reason", "undo", "grace_period", "dependency_effects", "irreversible_boundary", "audit", "notification"]}}}
          ]
        },
        {"properties": {"kind": {"const": "MIGRATION_RECONCILIATION"}, "surface_ref": {"type": "null"}, "pack_id": {"type": "null"}, "axis_id": {"type": "null"}, "source_path": {"$ref": "#/$defs/text"}}},
        {"properties": {"kind": {"const": "MANUAL"}, "surface_ref": {"type": "null"}, "pack_id": {"type": "null"}, "axis_id": {"type": "null"}, "source_path": {"type": "null"}}}
      ]
    },
    "unknown_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "consequences"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "statement": {"$ref": "#/$defs/text"},
        "consequences": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1}
      }
    },
    "unknown_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_option", "reasoning_refs", "tradeoffs", "confidence"],
      "properties": {
        "recommended_option": {"$ref": "#/$defs/text"},
        "reasoning_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "uniqueItems": true, "minItems": 1},
        "tradeoffs": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1},
        "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "confirmation_ready_recommendation": {
      "allOf": [
        {"$ref": "#/$defs/unknown_recommendation"},
        {"properties": {"confidence": {"const": "HIGH"}}}
      ]
    },
    "unknown_deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "accepted_by", "impact_review"],
      "properties": {
        "reason": {"$ref": "#/$defs/text"},
        "accepted_by": {"const": "user"},
        "impact_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "rules", "flows", "states", "privacy", "money", "security", "acceptance"],
          "properties": {
            "scope": {"$ref": "#/$defs/text"}, "rules": {"$ref": "#/$defs/text"},
            "flows": {"$ref": "#/$defs/text"}, "states": {"$ref": "#/$defs/text"},
            "privacy": {"$ref": "#/$defs/text"}, "money": {"$ref": "#/$defs/text"},
            "security": {"$ref": "#/$defs/text"}, "acceptance": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "accepted_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_option", "alternatives_presented", "tradeoffs_presented", "accepted_by", "accepted_at"],
      "properties": {
        "recommended_option": {"$ref": "#/$defs/text"},
        "alternatives_presented": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true, "minItems": 1},
        "tradeoffs_presented": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1},
        "accepted_by": {"const": "user"},
        "accepted_at": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "materiality": {
      "type": "object",
      "required": ["outcome_divergence", "fan_out", "user_visible", "reversibility", "risk_flags", "classification"],
      "properties": {
        "outcome_divergence": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH"]},
        "fan_out": {"enum": ["LOCAL", "MULTI_OBJECT", "MULTI_FLOW", "SYSTEMIC"]},
        "user_visible": {"type": "boolean"},
        "reversibility": {"enum": ["TRIVIALLY_REVERSIBLE", "REVERSIBLE", "COSTLY_TO_REVERSE", "IRREVERSIBLE"]},
        "risk_flags": {
          "type": "object",
          "required": ["security", "privacy", "money", "legal_or_policy", "destructive", "data_loss", "external_commitment"],
          "properties": {
            "security": {"type": "boolean"}, "privacy": {"type": "boolean"}, "money": {"type": "boolean"},
            "legal_or_policy": {"type": "boolean"}, "destructive": {"type": "boolean"},
            "data_loss": {"type": "boolean"}, "external_commitment": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "classification": {"enum": ["MATERIAL", "NON_MATERIAL"]}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["UNAPPROVED", "APPROVED"]},
        "approved_revision": {"type": "integer", "minimum": 1},
        "approved_definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "approved_by": {"const": "user"}
      },
      "oneOf": [
        {
          "required": ["status"],
          "properties": {"status": {"const": "UNAPPROVED"}},
          "maxProperties": 1
        },
        {
          "required": ["status", "approved_revision", "approved_definition_digest", "approved_manifest_digest", "approved_at", "approved_by"],
          "properties": {"status": {"const": "APPROVED"}}
        }
      ]
    },
    "approval_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "definition_digest", "manifest_digest", "record_hashes", "coverage_digest", "surface_digest", "grill_pack_set_digest"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_hashes": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z]+-[0-9]{3,}$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "coverage_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "surface_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grill_pack_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "discovery_baseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"enum": ["NOT_ESTABLISHED", "STALE"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "definition_revision", "surface_manifest_digest", "evidence_commitment_digest", "open_material_surface_count", "unresolved_material_contradiction_count", "procedure_complete", "applicable_surface_classes_complete", "active_grill_packs", "active_grill_packs_complete", "unknown_unknown_exhaustiveness_claimed"],
          "properties": {
            "status": {"const": "CURRENT"},
            "definition_revision": {"type": "integer", "minimum": 1},
            "surface_manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "evidence_commitment_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "open_material_surface_count": {"type": "integer", "minimum": 0},
            "unresolved_material_contradiction_count": {"type": "integer", "minimum": 0},
            "procedure_complete": {"type": "boolean"},
            "applicable_surface_classes_complete": {"type": "boolean"},
            "active_grill_packs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pack_id", "version", "digest", "target_refs"],
                "properties": {
                  "pack_id": {"type": "string", "pattern": "^GRILL-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]+$"},
                  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
                  "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "target_refs": {
                    "type": "array",
                    "items": {"type": "string", "pattern": "^(REQ|SURF)-[0-9]{3,}$"},
                    "uniqueItems": true
                  }
                }
              }
            },
            "active_grill_packs_complete": {"type": "boolean"},
            "unknown_unknown_exhaustiveness_claimed": {"const": false}
          }
        }
      ]
    },
    "grill_topology_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "surface_refs", "unknown_refs", "basis_refs", "rationale"],
      "properties": {
        "status": {"enum": ["ACTIVE", "N/A", "OPEN"]},
        "surface_refs": {"type": "array", "items": {"type": "string", "pattern": "^SURF-[0-9]{3,}$"}, "uniqueItems": true},
        "unknown_refs": {"type": "array", "items": {"type": "string", "pattern": "^UNK-[0-9]{3,}$"}, "uniqueItems": true},
        "basis_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3,}$"}, "uniqueItems": true},
        "rationale": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "grill_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AUTH", "MONEY", "FILE_UPLOAD", "ASYNC", "PERMISSION", "DESTRUCTIVE_ACTION"],
      "properties": {
        "AUTH": {"$ref": "#/$defs/grill_topology_cell"},
        "MONEY": {"$ref": "#/$defs/grill_topology_cell"},
        "FILE_UPLOAD": {"$ref": "#/$defs/grill_topology_cell"},
        "ASYNC": {"$ref": "#/$defs/grill_topology_cell"},
        "PERMISSION": {"$ref": "#/$defs/grill_topology_cell"},
        "DESTRUCTIVE_ACTION": {"$ref": "#/$defs/grill_topology_cell"}
      }
    },
    "grill_axis_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority_bindings", "unknown_refs", "basis_bindings", "rationale"],
      "properties": {
        "status": {"enum": ["ADDRESSED", "OPEN", "N/A"]},
        "authority_bindings": {"type": "array", "items": {"$ref": "#/$defs/authority_binding"}},
        "unknown_refs": {"type": "array", "items": {"type": "string", "pattern": "^UNK-[0-9]{3,}$"}, "uniqueItems": true},
        "basis_bindings": {"type": "array", "items": {"$ref": "#/$defs/authority_binding"}},
        "rationale": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "grill_coverage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ref", "pack_id", "pack_version", "pack_digest", "axes"],
      "properties": {
        "target_ref": {"type": "string", "pattern": "^SURF-[0-9]{3,}$"},
        "pack_id": {"enum": ["GRILL-AUTH-1", "GRILL-MONEY-1", "GRILL-FILE-UPLOAD-1", "GRILL-ASYNC-1", "GRILL-PERMISSION-1", "GRILL-DESTRUCTIVE-ACTION-1"]},
        "pack_version": {"const": "1.0"},
        "pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "axes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/grill_axis_coverage"}}
      }
    },
    "lifecycle_requirements": {
      "allOf": [
        {"if": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["status"]}, "then": {"required": ["superseded_by"]}},
        {"if": {"properties": {"status": {"const": "RETIRED"}}, "required": ["status"]}, "then": {"required": ["retired_by", "retired_at_revision", "retirement_reason"]}}
      ]
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "source_kind", "locator", "claim", "confidence", "authority_classes", "observed_version", "content_hash"],
      "properties": {
        "id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
        "status": {"enum": ["CURRENT", "STALE", "SUPERSEDED", "UNAVAILABLE"]},
        "source_kind": {"enum": ["USER_CONFIRMED_INTENT", "DOCUMENTED_INTENT", "HISTORICAL_DECISION", "EXTERNAL_CONSTRAINT", "OBSERVED_IMPLEMENTATION", "OBSERVED_RUNTIME", "TEST_ASSERTION", "DESIGN_ARTIFACT", "INFERRED_INTENT"]},
        "locator": {"$ref": "#/$defs/text"},
        "claim": {"$ref": "#/$defs/text"},
        "confidence": {"enum": ["DIRECT", "CORROBORATED", "INFERRED"]},
        "authority_classes": {"type": "array", "items": {"enum": ["FACTUAL", "INTENT", "CONSTRAINT", "BEHAVIORAL", "PREFERENCE"]}, "uniqueItems": true, "minItems": 1},
        "observed_version": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "content_hash": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "superseded_by": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
        "unavailable_reason": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["status"]}, "then": {"required": ["superseded_by"]}},
        {"if": {"properties": {"status": {"const": "UNAVAILABLE"}}, "required": ["status"]}, "then": {"required": ["unavailable_reason"]}}
      ]
    },
    "surface_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "status", "materiality", "evidence_refs", "authority_refs", "unknown_refs", "decision_refs", "contradiction_refs", "rationale", "intent_classification"],
      "properties": {
        "id": {"type": "string", "pattern": "^SURF-[0-9]{3,}$"},
        "kind": {"enum": ["ACTOR", "FEATURE_AREA", "ENTRY_POINT", "MAJOR_ACTION", "DOMAIN_ENTITY", "INTEGRATION", "ASYNC_PROCESS", "NOTIFICATION", "PERSISTENT_STATE", "SENSITIVE_DATA", "PERMISSION", "MONEY_FLOW", "DESTRUCTIVE_OPERATION", "LIFECYCLE_OBJECT"]},
