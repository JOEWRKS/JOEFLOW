{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JOEWRKS/joewrks-product-definition/state.schema.json",
  "title": "JOEWRKS Product Definition State v0.1.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "objects", "coverage", "ux_coverage", "contradictions"],
  "properties": {
    "schema_version": {"const": "0.1.2.1"},
    "project": {
      "type": "object",
      "required": ["slug", "status", "definition_revision", "user_approved", "approval"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "READY_FOR_REVIEW", "CLOSED", "BLOCKED"]},
        "definition_revision": {"type": "integer", "minimum": 1},
        "user_approved": {"type": "boolean"},
        "approval": {"type": "object", "required": ["approved_revision", "approved_digest", "approved_at"], "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals", "users", "requirements", "unknowns", "decisions", "rules", "flows", "screens", "states", "data", "integrations", "acceptance_criteria", "tasks"],
      "properties": {
        "goals": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "users": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "unknowns": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "flows": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "screens": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "states": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "data": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "integrations": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/object"}}
      }
    },
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/featureCoverage"}},
    "ux_coverage": {"type": "array", "items": {"$ref": "#/$defs/screenCoverage"}},
    "contradictions": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "object": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}, "status": {"type": "string"}, "resolution": {"type": "string"}, "decision": {"type": "string"}, "reason": {"type": "string"}, "recommendation": {"type": "string"}, "source": {"type": "string"}, "accepted_by": {"const": "user"}, "accepted_at": {"type": "string"}, "deferral_reason": {"type": "string"}, "non_blocking_impact_review": {"type": "object"}, "interactive": {"type": "boolean"}, "non_interactive_reason": {"type": "string"}, "major_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "no_major_actions_reason": {"type": "string"}, "superseded_by": {"type": "string"}},
      "additionalProperties": true
    },
    "coverageCell": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["COVERED", "N/A", "OPEN"]}, "rationale": {"type": "string"}},
      "additionalProperties": false
    },
    "featureCoverage": {
      "type": "object",
      "required": ["feature_id", "cells"],
      "properties": {"feature_id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"}, "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/coverageCell"}}},
      "additionalProperties": false
    },
    "screenCoverage": {
      "type": "object",
      "required": ["screen_id", "states", "actions"],
      "properties": {
        "screen_id": {"type": "string", "pattern": "^SCR-[0-9]{3}$"},
        "states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/coverageCell"}},
        "actions": {"type": "array", "items": {"type": "object", "required": ["key", "cells"], "properties": {"key": {"type": "string", "minLength": 1}, "cells": {"type": "object", "additionalProperties": {"$ref": "#/$defs/coverageCell"}}, "rationales": {"type": "object"}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    }
  }
}
