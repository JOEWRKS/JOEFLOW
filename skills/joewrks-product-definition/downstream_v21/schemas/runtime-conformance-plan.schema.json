{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "joewrks.runtime-conformance-plan/1.0",
  "type": "object",
  "required": ["plan_schema_version", "planner", "source_contract", "runtime_profile", "review_commitments", "actions", "lifecycles", "coverage_summary", "mapping_gaps", "plan_hash"],
  "additionalProperties": false,
  "properties": {
    "plan_schema_version": {"const": "joewrks.runtime-conformance-plan/1.0"},
    "planner": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "joewrks-product-definition/runtime-plan-v1"},
        "version": {"const": "core-semantic-closure-v2-m5.1"}
      }
    },
    "source_contract": {
      "type": "object",
      "required": ["contract_schema_version", "semantic_contract_hash", "approved_definition_digest", "product_slug"],
      "additionalProperties": false,
      "properties": {
        "contract_schema_version": {"const": "joewrks.action-conformance/2.1"},
        "semantic_contract_hash": {"$ref": "#/$defs/hash"},
        "approved_definition_digest": {"$ref": "#/$defs/hash"},
        "product_slug": {"type": "string", "pattern": ".*\\S.*"}
      }
    },
    "runtime_profile": {
      "type": "object",
      "required": ["profile_id", "digest"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"const": "joewrks.runtime-responsibility/1.0"},
        "digest": {"$ref": "#/$defs/hash"}
      }
    },
    "review_commitments": {"$ref": "#/$defs/reviewCommitments"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/actionPlan"}},
    "lifecycles": {"type": "array", "items": {"$ref": "#/$defs/lifecyclePlan"}},
    "coverage_summary": {"$ref": "#/$defs/coverageSummary"},
    "mapping_gaps": {"type": "array", "items": {"$ref": "#/$defs/mappingGap"}},
    "plan_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "fieldRef": {"type": "string", "pattern": "^(actions|lifecycles)/(?:[A-Za-z0-9._~-]|%(?:[01][0-9A-F]|2[0-CF]|3[A-F]|40|5[B-E]|60|7[B-F])|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E[1-9A-F](?:%[89AB][0-9A-F]){2}|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3](?:%[89AB][0-9A-F]){3}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})+/[^/\\s]+$"},
    "fieldRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldRef"}},
    "fieldRefsMaybeEmpty": {"type": "array", "items": {"$ref": "#/$defs/fieldRef"}},
    "reviewCommitments": {
      "type": "object",
      "required": ["package_hash", "output_hash", "completion", "reliability_status"],
      "additionalProperties": false,
      "properties": {
        "package_hash": {"$ref": "#/$defs/nullableHash"},
        "output_hash": {"$ref": "#/$defs/nullableHash"},
        "completion": {"enum": ["NOT_REQUIRED", "PENDING", "REVIEW_OUTPUT_RECORDED", "REENTRY_REQUIRED"]},
        "reliability_status": {"const": "NOT_MEASURED"}
      }
    },
    "componentExpectation": {
      "type": "object",
      "required": ["component", "expectation", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "component": {"enum": ["authoritative_state", "revision", "history", "business_side_effects", "delivery_effects"]},
        "expectation": {"enum": ["CHANGED", "UNCHANGED", "ANY"]},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "contractDerivedSource": {
      "type": "object",
      "required": ["source", "contract_field_path", "pointer"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "CONTRACT_DERIVED"},
        "contract_field_path": {"$ref": "#/$defs/fieldRef"},
        "pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "lifecycleCurrentStatesSource": {
      "type": "object",
      "required": ["source", "contract_field_path", "pointer"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "CONTRACT_DERIVED"},
        "contract_field_path": {"type": "string", "pattern": "^lifecycles/(?:[A-Za-z0-9._~-]|%(?:[01][0-9A-F]|2[0-CF]|3[A-F]|40|5[B-E]|60|7[B-F])|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E[1-9A-F](?:%[89AB][0-9A-F]){2}|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3](?:%[89AB][0-9A-F]){3}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})+/current_states$"},
        "pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "lifecycleAllowedTransitionsSource": {
      "type": "object",
      "required": ["source", "contract_field_path", "pointer"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "CONTRACT_DERIVED"},
        "contract_field_path": {"type": "string", "pattern": "^lifecycles/(?:[A-Za-z0-9._~-]|%(?:[01][0-9A-F]|2[0-CF]|3[A-F]|40|5[B-E]|60|7[B-F])|%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E[1-9A-F](?:%[89AB][0-9A-F]){2}|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3](?:%[89AB][0-9A-F]){3}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})+/allowed_transitions$"},
        "pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "verificationBasisSource": {
      "type": "object",
      "required": ["source", "seed_ref", "pointer"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "VERIFICATION_BASIS"},
        "seed_ref": {"type": "string", "pattern": "^SEED-[0-9a-f]{24}$"},
        "pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "presenceAssertion": {
      "type": "object",
      "required": ["type", "pointer", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["path_present", "path_absent"]},
        "pointer": {"type": "string", "pattern": "^/"},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "equalityAssertion": {
      "type": "object",
      "required": ["type", "pointer", "expected_value_source", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["path_equals", "collection_item_field_equals"]},
        "pointer": {"type": "string", "pattern": "^/"},
        "expected_value_source": {"oneOf": [{"$ref": "#/$defs/contractDerivedSource"}, {"$ref": "#/$defs/verificationBasisSource"}]},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "evidenceAssertion": {"oneOf": [{"$ref": "#/$defs/presenceAssertion"}, {"$ref": "#/$defs/equalityAssertion"}]},
    "fixtureRequirements": {
      "type": "array",
      "items": {"enum": ["OPAQUE_ID", "ATTEMPT_ID", "ORDERING_TIMESTAMP", "REVISION_INSTANCE"]}
    },
    "resultExpectation": {
      "type": "object",
      "required": ["result_class", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "result_class": {"enum": ["SUCCESS", "REJECTED", "STALE", "IDEMPOTENT_REPLAY"]},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "actionCase": {
      "type": "object",
      "required": ["case_id", "test_id", "result_expectation", "component_expectations", "evidence_assertions", "fixture_requirements", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "pattern": "^CASE-[0-9a-f]{24}$"},
        "test_id": {"type": "string", "pattern": "^TEST-[0-9a-f]{24}$"},
        "result_expectation": {"$ref": "#/$defs/resultExpectation"},
        "component_expectations": {"type": "array", "items": {"$ref": "#/$defs/componentExpectation"}},
        "evidence_assertions": {"type": "array", "items": {"$ref": "#/$defs/evidenceAssertion"}},
        "fixture_requirements": {"$ref": "#/$defs/fixtureRequirements"},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "transitionExpectation": {
      "type": "object",
      "required": ["from_state_source", "to_state_source", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "from_state_source": {"$ref": "#/$defs/lifecycleCurrentStatesSource"},
        "to_state_source": {"$ref": "#/$defs/lifecycleAllowedTransitionsSource"},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "lifecycleCase": {
      "type": "object",
      "required": ["case_id", "test_id", "transition_expectation", "component_expectations", "evidence_assertions", "fixture_requirements", "contract_field_refs"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "pattern": "^CASE-[0-9a-f]{24}$"},
        "test_id": {"type": "string", "pattern": "^TEST-[0-9a-f]{24}$"},
        "transition_expectation": {"$ref": "#/$defs/transitionExpectation"},
        "component_expectations": {"type": "array", "items": {"$ref": "#/$defs/componentExpectation"}},
        "evidence_assertions": {"type": "array", "items": {"$ref": "#/$defs/evidenceAssertion"}},
        "fixture_requirements": {"$ref": "#/$defs/fixtureRequirements"},
        "contract_field_refs": {"$ref": "#/$defs/fieldRefs"}
      }
    },
    "actionPlan": {
      "type": "object",
      "required": ["action_id", "covered_contract_field_refs", "cases"],
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": "string", "pattern": ".*\\S.*"},
        "covered_contract_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/actionCase"}}
      }
    },
    "lifecyclePlan": {
      "type": "object",
      "required": ["lifecycle_id", "covered_contract_field_refs", "cases"],
      "additionalProperties": false,
      "properties": {
        "lifecycle_id": {"type": "string", "pattern": ".*\\S.*"},
        "covered_contract_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/lifecycleCase"}}
      }
    },
    "coverageSummary": {
      "type": "object",
      "required": ["status", "runtime_critical_field_refs", "covered_field_refs", "missing_field_refs", "review_blocked_field_refs"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["COMPLETE", "INCOMPLETE"]},
        "runtime_critical_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"},
        "covered_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"},
        "missing_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"},
        "review_blocked_field_refs": {"$ref": "#/$defs/fieldRefsMaybeEmpty"}
      }
    },
    "mappingGap": {
      "type": "object",
      "required": ["code", "field_ref", "remediation"],
      "additionalProperties": false,
      "properties": {
        "code": {"const": "RUNTIME_MAPPING_GAP"},
        "field_ref": {"$ref": "#/$defs/fieldRef"},
        "remediation": {"const": "RUNTIME_PLAN"}
      }
    }
  }
}
