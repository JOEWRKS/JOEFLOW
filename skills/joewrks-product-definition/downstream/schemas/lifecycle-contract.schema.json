{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joewrks.example/schemas/lifecycle-contract.schema.json",
  "title": "JOEWRKS Lifecycle and Reversal Contract",
  "type": "object",
  "$defs": {
    "lifecycle": {
      "type": "object",
      "required": [
        "lifecycle_id", "sources", "current_states", "allowed_transitions", "forbidden_transitions",
        "boundary_conditions", "reversibility", "reversal_window", "object_outcome", "required_reason",
        "required_confirmation", "required_evidence", "authority", "history_preservation", "superseded_sentinels"
      ],
      "properties": {
        "lifecycle_id": {"type": "string"},
        "sources": {"type": "array", "minItems": 1},
        "current_states": {},
        "allowed_transitions": {},
        "forbidden_transitions": {},
        "boundary_conditions": {},
        "reversibility": {},
        "reversal_window": {},
        "object_outcome": {},
        "required_reason": {},
        "required_confirmation": {},
        "required_evidence": {},
        "authority": {},
        "history_preservation": {},
        "superseded_sentinels": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}
