{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joewrks.example/schemas/regression-slice.schema.json",
  "title": "JOEWRKS Evaluator Regression Slice",
  "type": "object",
  "required": ["contract_schema_version", "compiler", "source_authority", "actions", "lifecycles", "authority_assessment", "contract_hash"],
  "properties": {
    "contract_schema_version": {"const": "joewrks.downstream.regression-slice/1.0"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "source_authority": {"$ref": "#/$defs/authority"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "lifecycles": {"type": "array", "items": {"type": "object"}},
    "authority_assessment": {"$ref": "#/$defs/authorityAssessment"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "compiler": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["product_slug", "approved_revision", "approved_digest", "canonical_state_sha256"],
      "properties": {
        "product_slug": {"type": "string"},
        "approved_revision": {"type": "integer"},
        "approved_digest": {"type": "string"},
        "canonical_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["object_id", "pointer", "value_sha256", "source_status", "active"],
      "properties": {
        "object_id": {"type": "string"},
        "pointer": {"type": "string", "pattern": "^/"},
        "value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_status": {"enum": ["CURRENT", "SUPERSEDED"]},
        "active": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "machineDerivation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "operator"],
          "properties": {"kind": {"const": "MACHINE_DERIVED"}, "operator": {"const": "exact"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "operator", "pointer"],
          "properties": {"kind": {"const": "MACHINE_DERIVED"}, "operator": {"const": "extract"}, "pointer": {"type": "string", "pattern": "^/"}},
          "additionalProperties": false
        }
      ]
    },
    "reviewDerivation": {
      "type": "object",
      "required": ["kind", "explanation"],
      "properties": {"kind": {"const": "REVIEW_REQUIRED"}, "explanation": {"type": "string", "pattern": ".*\\S.*"}},
      "additionalProperties": false
    },
    "semanticField": {
      "type": "object",
      "required": ["value", "source_refs", "derivation"],
      "properties": {
        "value": {},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "derivation": {"oneOf": [{"$ref": "#/$defs/machineDerivation"}, {"$ref": "#/$defs/reviewDerivation"}]}
      },
      "additionalProperties": false
    },
    "authorityAssessment": {
      "type": "object",
      "required": ["structurally_valid", "provenance_valid", "machine_derived_obligations_verified", "machine_derived_field_count", "review_required_field_count", "review_required_obligations_present", "machine_verifiable_coverage"],
      "properties": {
        "structurally_valid": {"type": "boolean"},
        "provenance_valid": {"type": "boolean"},
        "machine_derived_obligations_verified": {"type": "boolean"},
        "machine_derived_field_count": {"type": "integer", "minimum": 0},
        "review_required_field_count": {"type": "integer", "minimum": 0},
        "review_required_obligations_present": {"type": "boolean"},
        "machine_verifiable_coverage": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["action_id", "sources", "default_result", "input_invariants", "result_expectations", "test_obligations"],
      "properties": {
        "action_id": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "default_result": {"$ref": "#/$defs/semanticField"},
        "input_invariants": {"$ref": "#/$defs/semanticField"},
        "result_expectations": {"$ref": "#/$defs/semanticField"},
        "test_obligations": {"$ref": "#/$defs/semanticField"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
