    ],
    "requirements": [
      {"id":"REQ-001","status":"CURRENT","material":true,"text":"Provide customer web booking and shop-admin schedule management for one service and one stylist per booking, including verified contact, deposit payment, atomic confirmation, management, cancellation/refund, reminders, and prescribed recovery states.","actors":["USR-001","USR-002","USR-003"],"screens":["SCR-001","SCR-002","SCR-003","SCR-004","SCR-005","SCR-006","SCR-007","SCR-008"],"rules":["RULE-001","RULE-002","RULE-003","RULE-004","RULE-005","RULE-006","RULE-007"],"acceptance":["AC-001","AC-002","AC-003","AC-004","AC-005"],"source":"closed-definition.md"}
    ],
    "unknowns": [],
    "decisions": [
      {"id":"DEC-001","status":"ANSWERED","material":true,"decision":"Use the approved revision 12 definition as the sole product authority for this handoff.","reason":"The evidence labels the definition approved and states no unresolved product decisions remain.","source":"evals/behavioral-v0.2/fixtures/figma-handoff/closed-definition.md"}
    ],
    "rules": [
      {"id":"RULE-001","status":"CURRENT","text":"One service and one stylist per booking; shop timezone governs displayed slots; timestamps persist in UTC.","depends_on":["DEC-001"]},
      {"id":"RULE-002","status":"CURRENT","text":"Use a 30-minute slot grid; duration blocks consecutive slots; bookings cannot overlap; server reservation is atomic.","depends_on":["DEC-001"]},
      {"id":"RULE-003","status":"CURRENT","text":"Require a 20% deposit and show deposit/refund policy before payment.","depends_on":["DEC-001"]},
      {"id":"RULE-004","status":"CURRENT","text":"Cancellation is free until 24 hours before start; afterward the deposit is non-refundable; one reschedule is allowed before the deadline.","depends_on":["DEC-001"]},
      {"id":"RULE-005","status":"CURRENT","text":"Admin cancellation issues a full refund; admin changes record actor, time, and reason.","depends_on":["DEC-001"]},
      {"id":"RULE-006","status":"CURRENT","text":"Send reminders 24 hours and 2 hours before the booking.","depends_on":["DEC-001"]},
      {"id":"RULE-007","status":"CURRENT","text":"Payment success without booking creation triggers automatic refund and a visible refund-pending recovery state; retries never duplicate payment or booking.","depends_on":["DEC-001"]}
    ],
    "flows": [
      {"id":"FLOW-001","status":"CURRENT","name":"Customer booking","steps":["choose service","choose stylist","choose available slot","verify mobile contact","review policy","pay deposit","atomic booking confirmation"],"screens":["SCR-001","SCR-002","SCR-003","SCR-004","SCR-005","SCR-006"],"requirements":["REQ-001"]},
      {"id":"FLOW-002","status":"CURRENT","name":"Customer booking management","steps":["verify ownership","view booking","reschedule or cancel when allowed","observe resulting status/refund"],"screens":["SCR-006"],"requirements":["REQ-001"]},
      {"id":"FLOW-003","status":"CURRENT","name":"Admin schedule management","steps":["open calendar","select booking","change or cancel with reason","record audit and refund when applicable"],"screens":["SCR-007","SCR-008"],"requirements":["REQ-001"]}
    ],
