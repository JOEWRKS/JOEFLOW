      {"id":"AC-001","status":"CURRENT","text":"For conflicting concurrent slot requests, exactly one booking succeeds.","requirements":["REQ-001"]},
      {"id":"AC-002","status":"CURRENT","text":"Deposit and refund policy is visible before payment submission.","requirements":["REQ-001"]},
      {"id":"AC-003","status":"CURRENT","text":"Confirmation shows shop-local date/time, service, stylist, price, and policy.","requirements":["REQ-001"]},
      {"id":"AC-004","status":"CURRENT","text":"Every specified failure state provides a visible recovery path and retry cannot duplicate payment or booking.","requirements":["REQ-001"]},
